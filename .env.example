# Kamru Ghati Honey - Environment Configuration
# Copy this file to .env.local and update with verified business values.
# IMPORTANT: Never commit actual credentials or private keys.

# Primary WhatsApp Business Number (Public ordering channel)
# Format: Country code + number without spaces, hyphens, or '+' sign.
# Example for India: 919876543210
# If empty or invalid, the website safely renders an enquiry pending state.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Canonical Site URL (Used for metadata, Open Graph, and sitemap)
NEXT_PUBLIC_SITE_URL=https://kamrughatihoney.com

# Optional Public Contact Placeholders (Leave empty if unconfirmed)
# When left empty, the website gracefully hides the corresponding section/link.
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=Mandi, Himachal Pradesh, India - 175001
NEXT_PUBLIC_FSSAI_NUMBER=
NEXT_PUBLIC_GST_NUMBER=
